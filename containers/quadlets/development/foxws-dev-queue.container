[Unit]
Description=Laravel queue worker (development)
After=foxws-dev.container
PartOf=foxws-dev.container
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=foxws-dev.build
AutoUpdate=local
HealthCmd=none
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan queue:work --sleep=3 --tries=3 --max-time=3600"
UserNS=keep-id
ShmSize=128m
Volume=foxws-dev-source.volume:/app:rw,z
Volume=foxws-dev-cache.volume:/cache:rw
Network=foxws-dev.network
NetworkAlias=systemd-foxws-queue

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
